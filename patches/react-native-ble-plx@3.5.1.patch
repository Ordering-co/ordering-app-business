-RCT_EXPORT_METHOD(createClient:(NSString*)restoreIdentifierKey) {
+// JavaScript calls this with null when no restore identifier is set (`new BleManager()`).
+// With the new architecture a null cannot be converted to an NSString* argument and the
+// app crashes: the parameter is `id` and a null (NSNull) is treated as no identifier.
+RCT_EXPORT_METHOD(createClient:(id)restoreIdentifierKeyOrNull) {
+    NSString *restoreIdentifierKey = [restoreIdentifierKeyOrNull isKindOfClass:[NSString class]]
+        ? (NSString *)restoreIdentifierKeyOrNull
+        : nil;
     _manager = [BleAdapterFactory getNewAdapterWithQueue:self.methodQueue
                                     restoreIdentifierKey:restoreIdentifierKey];
     _manager.delegate = self;
