{
  "sourceLanguage" : "en",
  "strings" : {
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App verwendet Bluetooth, um Belegdrucker in Ihrer Nähe zu finden und Tickets und Belege darauf zu drucken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app uses Bluetooth to find receipt printers near you and to print tickets and receipts on them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación usa Bluetooth para encontrar impresoras de tickets cerca de ti e imprimir en ellas tickets y recibos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application utilise le Bluetooth pour trouver les imprimantes de tickets à proximité et y imprimer des tickets et des reçus."
          }
        }
      }
    },
    "NSBluetoothPeripheralUsageDescription" : {
